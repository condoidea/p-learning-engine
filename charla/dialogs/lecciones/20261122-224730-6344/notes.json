  "lines": [
    {
      "ja": "ねえユキ、4チャンネルでスペイン映画をやってるよ。見ない？"
    },
    {
      "ja": "今から？ もう10時半よ。明日はすごく早起きしなきゃいけないのに。"
    },
    {
      "ja": "どうして？ 電車は何時に出るの？"
    },
    {
      "ja": "新幹線は7時15分発よ。7時には駅にいなきゃいけないの。"
    },
    {
      "ja": "7時に？ ひどいな！ で、君は何時に起きるつもり？"
    },
    {
      "ja": "5時半よ。着替えて、髪をとかして、朝ごはんを食べて、出る。わたしは夜にお風呂に入るの。そうすれば朝は時間にゆとりができるから。"
    },
    {
      "ja": "ぼくは違う。いつも朝にシャワーを浴びるんだ。それにひげもそらなきゃ。少なくとも30分は必要だよ。"
    },
    {
      "ja": "じゃあ、5時に起きなきゃね。"
    },
    {
      "ja": "わかった、わかった。ところで、電車ではどこに座るの？"
    },
    {
      "ja": "切符はここにあるわ。7列目のAとB席。あなたは窓側よ。晴れていれば富士山が見えるわ。"
    },
    {
      "ja": "いいね！ 明日の天気はどうなの？"
    },
    {
      "ja": "テレビによると、一日じゅう晴れるって。でも朝は肌寒いわ。上着を持っていってね。"
    },
    {
      "ja": "ねえ、こういう電車はだれがつくってるの？ すごく速いよね。"
    },
    {
      "ja": "日本のいくつかの会社よ。おじさんは新幹線の部品をつくる会社で働いているの。"
    },
    {
      "ja": "おもしろいね！"
    },
    {
      "ja": "それから京都では、まずおばあちゃんの家に行くの。あなたに会うのをとても楽しみにしているわ。"
    },
    {
      "ja": "ぼくもだよ！ ごあいさつするのが楽しみだ。スペインみたいに2回キスしてもいい？"
    },
    {
      "ja": "だめだめ！ 日本ではキスであいさつしないの。"
    }
  ],
  "names": [
    "Fuji"
  ]
}
